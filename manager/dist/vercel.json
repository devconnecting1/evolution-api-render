{
  "routes": [
    {
      "src": "^/(.*)$",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'sha256-+xWZOh0szMj2JMWPdd7EFBDQXUuR64ttRHh9UuA0JbM=' 'sha256-iGrup/2m1U3uk2eIbfgzL1L/XwIFmkFASjS1yq/yg+I=' 'sha256-XfpHiX5VO9sICpvg53dgHqZtl+wnlMZEoPhgONLvM70='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; worker-src 'self' blob:; manifest-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()",
        "Cross-Origin-Opener-Policy": "same-origin"
      },
      "continue": true
    },
    {
      "src": "^/manager/login/?$",
      "headers": {
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/\\.well-known/security\\.txt$",
      "dest": "/security.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      }
    },
    {
      "src": "^/\\.well-known/ard\\.json$",
      "dest": "/ard.json",
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "^/llms\\.txt$",
      "dest": "/llms.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      }
    },
    {
      "src": "^/agents/([a-z0-9-]+)\\.md$",
      "dest": "/agents/$1.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8"
      }
    },
    {
      "src": "^/$",
      "dest": "/landing/index.html"
    },
    {
      "src": "^/advocacia/?$",
      "status": 308,
      "headers": {
        "Location": "/#segmentos"
      }
    },
    {
      "src": "^/instagram/?$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/readmes?(/.*)?$",
      "status": 308,
      "headers": {
        "Location": "/manager/"
      }
    },
    {
      "src": "^/acesso/?$",
      "dest": "/acesso/index.html"
    },
    {
      "src": "^/seguranca/?$",
      "dest": "/landing/seguranca.html"
    },
    {
      "src": "^/novidades/?$",
      "dest": "/landing/novidades.html"
    },
    {
      "src": "^/privacidade/?$",
      "dest": "/landing/privacidade.html"
    },
    {
      "src": "^/termos/?$",
      "dest": "/landing/termos.html"
    },
    {
      "src": "^/docs/?$",
      "dest": "/docs/index.html"
    },
    {
      "src": "^/docs/(.+)$",
      "dest": "/docs/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/observability/?$",
      "dest": "/observability/index.html"
    },
    {
      "src": "^/manager(/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "^/(.*)$",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
