{
  "routes": [
    { "src": "^/$", "dest": "/landing/index.html" },
    { "src": "^/advocacia/?$", "dest": "/landing/advocacia.html" },
    { "src": "^/instagram/?$", "dest": "/landing/instagram.html" },
