model InstanceLimits {
  id                       String    @id @default(cuid())
  planName                 String?   @db.VarChar(30)
  monthlyResponses         Int?      @db.Integer
  dailyResponses           Int?      @db.Integer
  perContactDailyResponses Int?      @db.Integer
  overLimitAction          String    @default("continue") @db.VarChar(10)
  overLimitMessage         String?   @db.Text
  alertPercent             Int       @default(80) @db.Integer
  businessHours            Json?     @db.JsonB
  outsideHoursMessage      String?   @db.Text
  createdAt                DateTime? @default(now()) @db.Timestamp
  updatedAt                DateTime  @updatedAt @db.Timestamp
  Instance                 Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId               String    @unique
}

/// AI answers per instance: type "month" (period 2026-11), "day" (2026-11-03) and "contact" (day + remoteJid).
model UsageCounter {
  instanceId  String
  type        String   @db.VarChar(10)
  period      String   @db.VarChar(10)
  remoteJid   String   @default("") @db.VarChar(100)
  responses   Int      @default(0) @db.Integer
  limitNotice Boolean  @default(false) @db.Boolean
  hoursNotice Boolean  @default(false) @db.Boolean
  updatedAt   DateTime @updatedAt @db.Timestamp
  Instance    Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@id([instanceId, type, period, remoteJid])
}

/// "Processos": court cases monitored per instance (DataJud CNJ). numeroDigits = the 20 digits of the CNJ number.
model Process {
  id               String            @id @default(cuid())
  numeroCnj        String            @db.VarChar(25)
  numeroDigits     String            @db.VarChar(20)
  tribunalAlias    String            @db.VarChar(20)
  apelido          String?           @db.VarChar(120)
  clientName       String?           @db.VarChar(120)
  remoteJid        String?           @db.VarChar(100)
  classe           String?           @db.VarChar(200)
  assuntos         String?           @db.VarChar(300)
  orgaoJulgador    String?           @db.VarChar(200)
  dataAjuizamento  DateTime?         @db.Timestamp
  lastMovementAt   DateTime?         @db.Timestamp
  lastCheckedAt    DateTime?         @db.Timestamp
  lastSyncedAt     DateTime?         @db.Timestamp
  lastError        String?           @db.VarChar(300)
  errorCount       Int               @default(0) @db.Integer
  active           Boolean           @default(true) @db.Boolean
  notifyTeam       Boolean           @default(true) @db.Boolean
  notifyClient     Boolean           @default(false) @db.Boolean
  allowAiAnswer    Boolean           @default(false) @db.Boolean
  segredoJustica   Boolean           @default(false) @db.Boolean
  initialized      Boolean           @default(false) @db.Boolean
  lastClientNotice DateTime?         @db.Timestamp
  createdAt        DateTime          @default(now()) @db.Timestamp
  updatedAt        DateTime          @updatedAt @db.Timestamp
  Instance         Instance          @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId       String
  ProcessMovement  ProcessMovement[]
  Publication      Publication[]

  @@unique([instanceId, numeroDigits])
  @@index([instanceId, active, lastCheckedAt])
}

/// One movement (andamento) of a Process. hash = dedupe key of the DataJud movement (code + date + name + complements).
model ProcessMovement {
  id           String    @id @default(cuid())
  occurredAt   DateTime  @db.Timestamp
  code         Int?      @db.Integer
  name         String    @db.VarChar(300)
  complement   String?   @db.VarChar(500)
  hash         String    @db.VarChar(64)
  seenAt       DateTime? @db.Timestamp
  notifyStatus String    @default("none") @db.VarChar(10)
  createdAt    DateTime  @default(now()) @db.Timestamp
  Process      Process   @relation(fields: [processId], references: [id], onDelete: Cascade)
  processId    String

  @@unique([processId, hash])
  @@index([processId, occurredAt])
  @@index([notifyStatus])
}

/// OAB number watched on the DJEN (Comunica PJe) for intimações/publicações.
model OabWatch {
  id            String        @id @default(cuid())
  numeroOab     String        @db.VarChar(20)
  ufOab         String        @db.VarChar(2)
  label         String?       @db.VarChar(120)
  active        Boolean       @default(true) @db.Boolean
  initialized   Boolean       @default(false) @db.Boolean
  lastCheckedAt DateTime?     @db.Timestamp
  lastError     String?       @db.VarChar(300)
  errorCount    Int           @default(0) @db.Integer
  createdAt     DateTime      @default(now()) @db.Timestamp
  updatedAt     DateTime      @updatedAt @db.Timestamp
  Instance      Instance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId    String
  Publication   Publication[]

  @@unique([instanceId, numeroOab, ufOab])
}

/// Communication published on the DJEN. externalId = id of the communication on the Comunica API.
model Publication {
  id                String    @id @default(cuid())
  externalId        String    @db.VarChar(64)
  processNumber     String?   @db.VarChar(25)
  processDigits     String?   @db.VarChar(20)
  siglaTribunal     String?   @db.VarChar(20)
  tipo              String?   @db.VarChar(80)
  orgao             String?   @db.VarChar(200)
  disponibilizadaEm DateTime? @db.Timestamp
  texto             String?   @db.Text
  link              String?   @db.VarChar(500)
  seenAt            DateTime? @db.Timestamp
  notifyStatus      String    @default("none") @db.VarChar(10)
  createdAt         DateTime  @default(now()) @db.Timestamp
  Instance          Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId        String
  OabWatch          OabWatch? @relation(fields: [oabWatchId], references: [id], onDelete: SetNull)
  oabWatchId        String?
  Process           Process?  @relation(fields: [linkedProcessId], references: [id], onDelete: SetNull)
  linkedProcessId   String?

  @@unique([instanceId, externalId])
  @@index([instanceId, seenAt])
  @@index([notifyStatus])
}

/// "Processos" settings of an instance (one optional row). Without a row (or enabled = false) nothing runs.
model ProcessSettings {
  id                    String   @id @default(cuid())
  enabled               Boolean  @default(false) @db.Boolean
  checkEveryHours       Int      @default(6) @db.Integer
  djenDays              Int      @default(7) @db.Integer
  notifyNumbers         Json?    @db.JsonB
  quietHours            Json?    @db.JsonB
  clientMessageTemplate String?  @db.Text
  createdAt             DateTime @default(now()) @db.Timestamp
  updatedAt             DateTime @updatedAt @db.Timestamp
  Instance              Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId            String   @unique
}

/// "Leads (triagem)": one structured lead per private conversation of an instance (filled by the AI extraction).
model Lead {
  id                  String    @id @default(cuid())
  remoteJid           String    @db.VarChar(100)
  pushName            String?   @db.VarChar(100)
  name                String?   @db.VarChar(120)
  area                String?   @db.VarChar(60)
  city                String?   @db.VarChar(80)
  summary             String?   @db.VarChar(600)
  status              String    @default("novo") @db.VarChar(20)
  statusSource        String    @default("ai") @db.VarChar(10)
  manualFields        Json?     @db.JsonB
  priority            String    @default("normal") @db.VarChar(10)
  priorityRank        Int       @default(1) @db.Integer
  priorityReason      String?   @db.VarChar(160)
  missingInfo         Json?     @db.JsonB
  nextStep            String?   @db.VarChar(200)
  opposingParty       String?   @db.VarChar(120)
  hasLawyer           Boolean?  @db.Boolean
  documentsMentioned  Json?     @db.JsonB
  mediaCount          Int       @default(0) @db.Integer
  source              String?   @db.VarChar(60)
  firstMessageAt      DateTime? @db.Timestamp
  lastMessageAt       DateTime? @db.Timestamp
  lastClientMessageAt DateTime? @db.Timestamp
  lastHumanReplyAt    DateTime? @db.Timestamp
  awaitingHumanSince  DateTime? @db.Timestamp
  lastExtractedAt     DateTime? @db.Timestamp
  extractedFromCount  Int       @default(0) @db.Integer
  notifiedAt          DateTime? @db.Timestamp
  createdAt           DateTime  @default(now()) @db.Timestamp
  updatedAt           DateTime  @updatedAt @db.Timestamp
  Instance            Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId          String

  @@unique([instanceId, remoteJid])
  @@index([instanceId, status, updatedAt])
}

/// "Leads (triagem)": optional settings per instance (no row = extraction on, notifications off).
model LeadSettings {
  id              String    @id @default(cuid())
  enabled         Boolean   @default(true) @db.Boolean
  areas           Json?     @db.JsonB
  extractionModel String?   @db.VarChar(100)
  notifyEnabled   Boolean   @default(false) @db.Boolean
  notifyNumbers   Json?     @db.JsonB
  notifyOn        String    @default("ambos") @db.VarChar(12)
  createdAt       DateTime? @default(now()) @db.Timestamp
  updatedAt       DateTime  @updatedAt @db.Timestamp
  Instance        Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId      String    @unique
}

/// "Agenda": scheduling settings per instance (no row = agenda off). JSON columns are normalized by src/utils/agenda.ts.
model AgendaSettings {
  id               String    @id @default(cuid())
  enabled          Boolean   @default(false) @db.Boolean
  timezone         String    @default("America/Sao_Paulo") @db.VarChar(64)
  /// internal (the WhatsAI agenda). Google Calendar comes as another provider later.
  provider         String    @default("internal") @db.VarChar(20)
  slotMinutes      Int       @default(30) @db.Integer
  bufferMinutes    Int       @default(0) @db.Integer
  minNoticeHours   Int       @default(2) @db.Integer
  maxDaysAhead     Int       @default(30) @db.Integer
  availability     Json?     @db.JsonB
  blocks           Json?     @db.JsonB
  appointmentTypes Json?     @db.JsonB
  reminders        Json?     @db.JsonB
  confirmation     Json?     @db.JsonB
  aiPermissions    Json?     @db.JsonB
  notifyNumbers    Json?     @db.JsonB
  icsToken         String?   @unique @db.VarChar(64)
  /// Bumped inside every booking transaction: the row lock serializes concurrent bookings of the instance.
  bookingSeq       Int       @default(0) @db.Integer
  createdAt        DateTime? @default(now()) @db.Timestamp
  updatedAt        DateTime  @updatedAt @db.Timestamp
  Instance         Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId       String    @unique
}

/// "Agenda": one appointment (UTC instants). Status agendado | confirmado | cancelado | realizado | faltou.
model Appointment {
  id              String    @id @default(cuid())
  remoteJid       String    @db.VarChar(100)
  contactName     String?   @db.VarChar(120)
  typeName        String    @db.VarChar(80)
  mode            String?   @db.VarChar(12)
  startsAt        DateTime  @db.Timestamptz(3)
  endsAt          DateTime  @db.Timestamptz(3)
  status          String    @default("agendado") @db.VarChar(12)
  notes           String?   @db.Text
  source          String    @default("manual") @db.VarChar(8)
  remindersSent   Json?     @db.JsonB
  awaitingReplyAt DateTime? @db.Timestamptz(3)
  confirmedAt     DateTime? @db.Timestamptz(3)
  cancelledAt     DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  Instance        Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId      String

  @@index([instanceId, startsAt])
  @@index([instanceId, remoteJid, startsAt])
  @@index([status, startsAt])
}

/// Banco próprio por instância (plano de controle). Sem FK para Instance de propósito:
/// o mapeamento sobrevive à remoção da instância (dados guardados no projeto Neon).
model InstanceDatabase {
  id                String    @id @default(cuid())
  instanceId        String    @unique
  provider          String    @default("neon") @db.VarChar(20)
  externalProjectId String?   @db.VarChar(100)
  region            String?   @db.VarChar(50)
  connectionUri     String    @db.Text
  status            String    @default("provisioning") @db.VarChar(20)
  lastError         String?   @db.Text
  migratedAt        DateTime? @db.Timestamp
  createdAt         DateTime  @default(now()) @db.Timestamp
  updatedAt         DateTime  @updatedAt @db.Timestamp
}
